DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Заполняются по мере подключения реальных сервисов (см. README, «Фаза 2»):
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YANDEX_MAPS_API_KEY=
# YANDEX_GEOCODER_API_KEY=
# SMS_RU_API_KEY=

# Админка, фаза 1 — S3-совместимое хранилище картинок (не Supabase Storage:
# база и хостинг переезжают на reg.ru/аналог, картинки не должны тянуть за
# собой отдельную привязку к Supabase). Подходит любой S3-совместимый
# провайдер — Yandex Object Storage, Selectel, VK Cloud, тот же Supabase
# Storage на переходный период при желании.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=

# Админка, фаза 1 — подпись сессии (httpOnly cookie), не путать с публичным
# ключом. Генерировать один раз, например: openssl rand -base64 32
# ADMIN_SESSION_SECRET=
