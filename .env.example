# ?connection_limit=2 держит сборку стабильной на маленьких пулах (Supabase
# pool_size: 15) — next build параллельно пререндерит страницы в нескольких
# воркерах, каждый со своим PrismaClient, и без лимита это упирается в
# EMAXCONNSESSION даже без посторонней нагрузки на базу. На боевой БД с
# нормальным max_connections не обязательно, но не мешает.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=2"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=2"

# Заполняются по мере подключения реальных сервисов (см. README, «Фаза 2»):
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Проверка адреса доставки (город + расстояние до кафе) и карта на сайте —
# через бесплатный OpenStreetMap/Nominatim (src/lib/geocoder.ts,
# src/components/CafeMap.tsx). Ключ не нужен — платные сервисы Яндекса
# сознательно не подключали. У Nominatim жёсткая политика использования
# (~1 запрос/сек на IP), при заметном росте заказов понадобится либо платный
# геокодер, либо свой инстанс Nominatim.

# Код входа в /profile доставляется Telegram-ботом (не SMS — дешевле и
# доставка мгновенная). Токен от @BotFather; без него /profile отдаёт
# «Вход через Telegram сейчас недоступен» при попытке запросить код.
# TELEGRAM_BOT_TOKEN=

# Картинки из админки хранятся прямо на диске сервера (public/uploads,
# src/lib/uploadStorage.ts) — переменных окружения не требуется. При
# переносе на новый VPS папку public/uploads нужно перенести отдельно,
# так же как базу (см. DEPLOYMENT.md).

# Админка, фаза 1 — подпись сессии (httpOnly cookie), не путать с публичным
# ключом. Генерировать один раз, например: openssl rand -base64 32
# ADMIN_SESSION_SECRET=

# Сессия покупателя после входа по коду в Telegram (/profile) — отдельный
# секрет от ADMIN_SESSION_SECRET (разные домены доверия). Без него вход
# работает (код проверяется), но профиль не откроется — verifyCustomerSession
# выбросит ошибку. Генерировать так же: openssl rand -base64 32
# CUSTOMER_SESSION_SECRET=

# Домен сайта без завершающего слэша (например https://goodkarma.cafe) —
# нужен только чтобы Telegram-уведомление о новом заказе несло кликабельную
# ссылку на карточку в /admin/orders. Без него уведомление всё равно
# приходит, просто без ссылки.
# SITE_URL=
